# Auth (file-based backend)
JWT_SECRET=your-super-secret-jwt-secret

# Where live data lives (file-based backend). Defaults to <app>/data.
# On a VPS, point it outside the deploy folder so redeploys can never touch
# it (see DEPLOYMENT.md).
# DATA_DIR=/var/lib/daaru/data

# Flutterwave (use test keys for development)
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxx
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxx
# Webhook secret hash (Flutterwave dashboard > Settings > Webhooks)
FLUTTERWAVE_WEBHOOK_HASH=your-webhook-secret-hash

# Email notifications (Resend - free tier: 100 emails/day)
# Get an API key: https://resend.com/api-keys
RESEND_API_KEY=re_your-resend-api-key
# Verified sender (e.g. "Daaru Kutubul Athaariyyah <orders@yourdomain.com>")
# Leave empty to use Resend's onboarding sandbox (test deliveries only)
RESEND_FROM_EMAIL=

# Appwrite (for later migration from the file-based backend)
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=your-project-id
APPWRITE_API_KEY=your-appwrite-api-key
